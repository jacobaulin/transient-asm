*lib ./stlib/dynamic_linked_list.tasm

set lista 6

cal #dyll_initialize_list
mov dyll_ret1 lista
puti lista
putc 10
//hlt
mov lista dyll_arg1
mov 5 dyll_arg2
cal #dyll_add_element
mov 1 dyll_arg2
cal #dyll_lookup_element
puti dyll_ret1

putc 10

mov 7 dyll_arg2
mov 1 dyll_arg3
cal #dyll_change_element
mov 1 dyll_arg2
cal #dyll_lookup_element
puti dyll_ret1

putc 10

cal #dyll_count_elements
puti dyll_ret1

putc 10

mov 1 dyll_arg2
cal #dyll_add_element
mov 2 dyll_arg2
cal #dyll_add_element
mov 3 dyll_arg2
cal #dyll_add_element
mov 4 dyll_arg2
cal #dyll_add_element
mov 5 dyll_arg2
cal #dyll_add_element
cal #dyll_count_elements
puti dyll_ret1

putc 10

mov 4 dyll_arg2
cal #dyll_delete_element
cal #dyll_count_elements
puti dyll_ret1


putc 10

mov 4 dyll_arg2
cal #dyll_lookup_element
puti dyll_ret1
putc 10
mov 3 dyll_arg2
cal #dyll_lookup_element
puti dyll_ret1
putc 10
mov 5 dyll_arg2
cal #dyll_lookup_element
puti dyll_ret1

putc 10
hlt

