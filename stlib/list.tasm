// List management library for fixed size lists

*lib ./stlib/memory.tasm

// Initialize new list
// arg1: list_size, ret1: list_base_ptr
#list_initialize
cal __list_initialize
ret

// Set list index value
// arg1: list_base_ptr, arg2: list_index, arg3: value
#list_set_index
call #__list_set_index
ret

// Get list index value
// arg1: list_base_ptr, arg2: list_index, ret1: value
#list_get_index
call __list_get_index
ret

// Print list
// arg1: list_base_ptr, arg2: list_size
#list_print
call #__list_print
ret


#__list_initialize
mov list_arg1 memory_arg1
mov memory_ret1 list_ret1
cal #memory_allocate
ret

#__list_set_index
set __list_set_index_ptr
set __list_set_index_offset
mov list_arg2 __list_set_index_offset
mul 8 __list_set_index_offset __list_set_index_offset
add list_arg1 __list_set_index_offset __list_set_index_ptr
mov list_arg3 >__list_set_index_ptr
ret

#__list_get_index
set __list_get_index_ptr
set __list_get_index_offset
mov list_arg2 __list_get_index_offset
mul 8 __list_get_index_offset __list_get_index_offset
add list_arg1 __list_get_index_offset __list_get_index_ptr
mov >__list_get_index_ptr list_ret1
ret

#__list_print
set __list_print_i
set __list_print_len
set __list_print_res
mov 0 __list_dump_i
mov list_arg2 __list_print_len
putc 91
#__list_print_inner
mov __list_print_i list_arg2
cal #__list_get_index
puti list_ret1
putc 44
add 1 __list_dump_i __list_dump_i
cgt __list_dump_i __list_dump_len __list_dump_res
jne #__list_dump_inner __list_dump_res
putc 93
putc 10
ret


set list_arg1
set list_arg2
set list_arg3

set list_ret1