// Initialize variables
set current_num 1
set divisor 2
set remainder 0
set is_done_checking 0

set newline 10


// Main infinite loop
#outer_loop

add current_num 1 current_num
mov current_num divisor
divt divisor 2 divisor

#inner_loop
rem current_num divisor remainder
jne #outer_loop remainder
equ divisor 2 is_done_checking
jie #division_done is_done_checking
sub divisor 1 divisor
jmp #inner_loop

// Stop inner loop
#division_done

puti current_num
putc newline

jmp #outer_loop
// Stop outer loop

